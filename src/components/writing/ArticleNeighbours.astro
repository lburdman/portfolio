---
/**
 * "What happened next" — the two articles either side of this one in time.
 *
 * The section is a chronology, so the honest link at the end of a field report
 * is not "related reading", it is the next thing that happened. That is why
 * this exists instead of a tag-similarity list.
 *
 * `older` / `newer` rather than previous / next, following
 * `articleNeighbours()` in `src/lib/writing/query.ts`: the index runs
 * newest-first, so "next" means opposite things depending on whether you are
 * thinking about the page or about the calendar. The visible labels say
 * *Earlier* and *Later*, which are unambiguous in both.
 *
 * Rendered in calendar order — earlier on the left, later on the right —
 * regardless of which one exists, so the pair reads as a segment of the axis
 * the index draws. When only one neighbour exists the other slot is simply
 * absent: no placeholder, no greyed-out arrow.
 *
 * Both neighbours come from `getArticleNeighbours()`, which walks the same
 * `visibleArticles` sequence the index renders, so this pagination cannot step
 * into a draft (AUDIT.md 2.1).
 */

import ArticleDate from '@/components/writing/ArticleDate.astro';
import { localizePath, type Locale, type UIStrings } from '@/i18n';
import type { Article } from '@/lib/writing';

interface Props {
  /** The article one step back in time, if this is not the earliest. */
  older: Article | undefined;
  /** The article one step forward in time, if this is not the most recent. */
  newer: Article | undefined;
  t: UIStrings;
  /** Needed as well as `base` — AUDIT.md 1.3. */
  locale: Locale;
  base: string;
}

const { older, newer, t, locale, base }: Props = Astro.props;

/** Earlier first: the pair is a fragment of the timeline, read left to right. */
const links = [
  older ? { article: older, label: t.writing.older, direction: 'older' } : null,
  newer ? { article: newer, label: t.writing.newer, direction: 'newer' } : null,
].filter((link): link is NonNullable<typeof link> => link !== null);
---

{
  links.length > 0 && (
    <nav class="neighbours" aria-label={t.a11y.articleNavigation}>
      <ul class="neighbours__list">
        {links.map((link) => (
          <li class="neighbours__item" data-direction={link.direction}>
            <a class="neighbours__link" href={localizePath(`/writing/${link.article.meta.slug}`, locale, base)}>
              {/* The direction word is part of the link's accessible name on
                  purpose: "Earlier — Noche de los Museos at FIUBA" is a
                  complete destination read out of context, where the bare title
                  leaves a screen-reader user to infer which way it goes. */}
              <span class="neighbours__label">{link.label}</span>
              <span class="neighbours__title">{link.article.title}</span>
            </a>
            <ArticleDate date={link.article.meta.date} locale={locale} />
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .neighbours {
    margin-top: var(--spacing-block);
    padding-top: var(--spacing-stack);
    border-top: var(--border-hairline) solid var(--color-rule);
  }

  .neighbours__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .neighbours__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-gutter-lg);
    }

    /* A lone `newer` neighbour still sits in the right-hand column, so the
       axis's direction survives the article being the earliest one. A data
       attribute matched by a static rule rather than a computed `grid-column`,
       because an inline style is dropped by the CSP — see the note in
       `WritingTimeline.astro`. */
    .neighbours__item[data-direction='newer'] {
      grid-column: 2;
      text-align: right;
    }
  }

  .neighbours__label {
    display: block;
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .neighbours__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .neighbours__title {
    display: block;
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-stretch: var(--display-width-expanded);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.22em;
    text-wrap: pretty;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .neighbours__link:hover .neighbours__title,
  .neighbours__link:focus-visible .neighbours__title {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .neighbours__item :global(time) {
    margin-top: 0.5rem;
  }
</style>
