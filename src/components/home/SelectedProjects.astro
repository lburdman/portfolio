---
/**
 * The homepage's Selected Projects section.
 *
 * This is where the site comes back down. Technical Worlds is the one big
 * motion moment (MOTION_SYSTEM §3); immediately after it the ground returns to
 * paper and the page goes quiet so the work can be read. There is no entrance
 * choreography here, no pinned sequence and no island — the whole section is
 * static HTML plus CSS. That restraint is the design, not a shortcut.
 *
 * ## Section identity is derived, never written down here
 *
 * The element `id`, the figure number and the localized margin word all come
 * from one place: `section="projects"` handed to `ui/Section.astro`, which
 * resolves the number from `SECTION_IDS.indexOf()` and the word from
 * `t.sections[id]`.
 *
 * This deliberately replaced a hardcoded `index = '03'` default. That literal
 * was *correct* — it equalled the array position — which is precisely what made
 * it dangerous: reordering `SECTION_IDS` would have renumbered every other
 * section and silently left this one at `03`. `SectionId` is a union over that
 * array, so `'projects'` leaving it is now a type error rather than a drifting
 * number. Audit 5.1 was two files disagreeing because a shared fact had been
 * written down twice.
 *
 * ## Visibility
 *
 * The featured set comes from `getFeaturedProjects()`, which is built on the
 * single `isVisible()` predicate. This component does not know what `status`
 * is, does not read `featured`, and does not filter. Audit 2.1 was exactly the
 * duplication of that logic across the homepage, the listing and the detail
 * route; there is now one place it can live and this is not it.
 *
 * ## Headings
 *
 * The page owns the `<h1>`. This section opens at `<h2>` and hands `3` down to
 * the cards, so the document never skips a level (audit 2.2 found the projects
 * index going h1 → h3). The margin annotation is `aria-hidden` inside `Section`
 * — the section is already named for assistive technology by `aria-labelledby`
 * pointing at that `<h2>`, so announcing the figure line first would be
 * repetition, not access.
 */

import ProjectGrid from '@/components/projects/ProjectGrid.astro';
import Section from '@/components/ui/Section.astro';
import type { SectionId } from '@/config/navigation';
import { localizePath, type Locale, type UIStrings } from '@/i18n';
import { getFeaturedProjects } from '@/lib/projects';

interface Props {
  t: UIStrings;
  /** Carried alongside `base` so the ES homepage links to ES pages (audit 1.3). */
  locale: Locale;
  base: string;
}

const { t, locale, base } = Astro.props;

/**
 * Typed, not stringly. If `'projects'` is ever removed from `SECTION_IDS` this
 * stops compiling instead of rendering a section with no number and no label.
 */
const SECTION: SectionId = 'projects';

const projects = await getFeaturedProjects(locale);
const headingId = `${SECTION}-heading`;
const allProjectsHref = localizePath('/projects', locale, base);

/*
 * NO `width="wide"` HERE, AND THAT IS THE FIX FOR A REAL DEFECT.
 *
 * This section used to opt into `--container-wide` (84rem) so the `lead`
 * project could span the full measure. `lead` is gone — the listing is a set
 * of equals now — so the wider container had nothing left to buy, and it was
 * costing something: it put the projects' own content column underneath the
 * layer spine.
 *
 * The spine positions itself with
 *   margin-inline-start: clamp(0.75rem, (100vw - var(--container-content))/2 - 4.5rem, 7rem)
 * which reserves a lane against `--container-content` (68rem). A section that
 * renders at `--container-wide` reaches past that lane, and since the spine
 * paints *behind* the section (tree order; `.section__inner` is z-index 1),
 * the result was a hairline running straight through the card — under the
 * title, the summary and the tags. Measured, spine right edge vs content left
 * edge, at `wide`:
 *
 *   1180px  6px into the column      1512px  68px
 *   1280px  18px                     1600px  24px
 *   1440px  96px                     1728px  clear
 *
 * So it was broken across every common laptop width and correct only on very
 * wide displays, which is why it survived review. At `content` the spine
 * clears the column by 8px at 1180 and by more at every width above it.
 *
 * The rule this encodes: the spine's lane is reserved against
 * `--container-content`, so anything wider than that on the homepage will run
 * over it. `TechnicalWorlds` is also `wide`, but it paints its own ink band
 * across the full bleed, so the spine is deliberately hidden there rather than
 * colliding with type.
 */
---

<Section section={SECTION} label={t.sections[SECTION]} labelledBy={headingId}>
  <header class="selected__header">
    <h2 id={headingId}>{t.projects.heading}</h2>
    <p class="selected__lede">{t.projects.subtitle}</p>
  </header>

  <ProjectGrid projects={projects} t={t} locale={locale} base={base} headingLevel={3} numbered />

  <p class="selected__more">
    <a class="selected__all" href={allProjectsHref}>
      {t.projects.viewAll}<span class="selected__arrow" aria-hidden="true">&#8594;</span>
    </a>
  </p>
</Section>

<style>
  /* The <section>, the measure, the vertical rhythm and the margin annotation
     all belong to `ui/Section.astro`. What remains here is only what is
     specific to this section's content. */

  .selected__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: var(--container-prose);
    margin-bottom: var(--spacing-block);
  }

  .selected__lede {
    font-size: var(--text-lg);
    color: var(--color-slate);
    text-wrap: pretty;
  }

  .selected__more {
    margin-top: var(--spacing-block);
    padding-top: var(--spacing-stack);
    border-top: var(--border-hairline) solid var(--color-rule);
  }

  .selected__all {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink);
    border-bottom: var(--border-rule) solid var(--color-rule);
    padding-bottom: 0.25rem;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .selected__all:hover,
  .selected__all:focus-visible {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .selected__arrow {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .selected__all:hover .selected__arrow,
  .selected__all:focus-visible .selected__arrow {
    transform: translateX(0.25em);
  }
</style>
