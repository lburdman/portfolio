---
/**
 * SECTION 00 — identity understood in about thirty seconds (brief §5).
 *
 * Everything semantic is plain HTML and renders immediately. It never waits on
 * the background field, on a font, or on a script; there is no preloader, and
 * the `<h1>` has no resting `opacity: 0` (audit 2.3). If JavaScript never runs,
 * the field still renders — as the static ruled sheet its stylesheet declares.
 * The only thing missing is the pointer response.
 *
 * `locale` is a required prop, not an optional one. Audit 1.3 was `Hero`
 * receiving `base` without `locale`, so every CTA on the Spanish homepage
 * pointed at an English page. Every href below goes through `localizePath`
 * with the locale it was handed.
 *
 * ── The credibility strip ───────────────────────────────────────────────────
 *
 * Three lines of provenance between the positioning sentence and the CTA row
 * (REDESIGN_DECISIONS P5 #20). Before it, no string in either dictionary
 * carried a degree, a certification or a MicroMasters — the site asked to be
 * believed on the strength of its own copy.
 *
 * The cap of three is enforced by the type, not by this file: `credentials` is
 * a `CredentialTrio`, a fixed 3-tuple, so a fourth badge is a compile error in
 * both dictionaries. That is the same reasoning as `Record<DomainId, T>`, and
 * it is what keeps a strip from becoming a wall.
 *
 * The technical-area row is a real `<nav>` of real links. Nothing about it is
 * hover-only — brief §14 requires that anything a pointer reveals be reachable
 * by tap and by keyboard, so there is nothing to reveal in the first place.
 */

import ActionLink from '@/components/ui/ActionLink.astro';
import Section from '@/components/ui/Section.astro';
import MagnetField from '@/components/visuals/hero/MagnetField.astro';
import { DOMAINS, domainOrdinal } from '@/config/domains';
import { CONTACT_SECTION_ID, HOME_PATH } from '@/config/navigation';
import { SITE } from '@/config/site';
import { localizePath, type Locale, type UIStrings } from '@/i18n';

interface Props {
  locale: Locale;
  t: UIStrings;
  base: string;
}

const { locale, t, base } = Astro.props;

const homeHref = localizePath(HOME_PATH, locale, base);
const projectsHref = localizePath('/projects', locale, base);
const contactHref = `${homeHref}#${CONTACT_SECTION_ID}`;
const resumeHref = SITE.resumePath === null ? null : `${base}${SITE.resumePath}`;

/** Localized label per social id, so no profile name is written twice. */
const socialLabels = {
  github: t.contact.githubLabel,
  linkedin: t.contact.linkedinLabel,
  email: t.contact.emailLabel,
} as const;

const profiles = SITE.social.filter((link) => link.id !== 'email');

/**
 * Anchors into the Technical Worlds band. The ids are owned by that component;
 * this is the contract between the two — `world-<domain id>`.
 */
const areas = DOMAINS.map((domain) => ({
  id: domain.id,
  ordinal: domainOrdinal(domain),
  name: t.worlds.items[domain.id].name,
  href: `${homeHref}#world-${domain.id}`,
}));

const HEADING_ID = 'hero-heading';
---

<Section section="hero" label={t.sections.hero} labelledBy={HEADING_ID} spacing="none" class="hero">
  <MagnetField slot="bleed" />

  <div class="hero__lockup">
    <h1 id={HEADING_ID} class="hero__name">{t.hero.name}</h1>
    <p class="hero__role">{t.hero.role}</p>
  </div>

  <p class="hero__positioning">{t.hero.positioning}</p>

  <ul class="hero__credentials">
    {t.hero.credentials.map((credential) => <li class="hero__credential">{credential}</li>)}
  </ul>

  <div class="hero__actions">
    <ActionLink href={projectsHref} variant="primary" arrow>{t.hero.ctaProjects}</ActionLink>
    <ActionLink href={contactHref} variant="secondary">{t.hero.ctaContact}</ActionLink>
    {
      resumeHref && (
        <ActionLink href={resumeHref} variant="secondary">
          {t.hero.ctaResume}
        </ActionLink>
      )
    }
    {
      profiles.map((link) => (
        <ActionLink href={link.href} variant="quiet">
          {socialLabels[link.id]}
        </ActionLink>
      ))
    }
  </div>

  <nav class="hero__areas" aria-label={t.worlds.heading}>
    <ul class="hero__areas-list">
      {
        areas.map((area) => (
          <li>
            <a class="hero__area" href={area.href}>
              <span class="hero__area-ordinal" aria-hidden="true">
                {area.ordinal}
              </span>
              <span class="hero__area-name">{area.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Section>

<style>
  .hero {
    /* Tall enough to be a threshold, never so tall that the next section is a
       surprise. `svh` avoids the mobile URL-bar jump.

       RETUNED — REDESIGN_DECISIONS P4 #17 measured 92% of the first viewport
       empty, with 144px dead bands at the top and bottom. At 1440x900 the old
       `min(92svh, 60rem)` plus `spacing="lg"` produced an 859px section around
       571px of content: 288px of it was section padding alone, and the next
       section began exactly one pixel below the fold, so nothing signalled
       that the page continued. This is 738px around the same content, and the
       Layers section now breaks the fold by ~95px. */
    min-height: min(82svh, 50rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  /* The hero owns its own rhythm, which is why `spacing="none"` is passed to
     `Section` rather than `lg`. Two classes so this reliably outranks
     `.section--none` regardless of stylesheet order. */
  .hero.section {
    padding-block: 4.5rem;
  }

  .hero__lockup {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero__name {
    font-size: var(--text-display-1);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    font-stretch: var(--display-width-expanded);
    max-width: 14ch;
  }

  .hero__role {
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .hero__positioning {
    max-width: var(--container-prose);
    margin-top: var(--spacing-stack);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  /* --- credibility strip ---------------------------------------------------
     Provenance, not decoration. It borrows the type treatment of the
     technical-area row below the CTAs — mono, micro, uppercase, slate — so it
     introduces no new visual language and cannot outweigh the name it sits
     under. The list is a fixed 3-tuple in the dictionary, so the layout below
     is allowed to assume exactly three items.

     Below 64rem the three sit in a column with no rules: three uppercase mono
     lines wrap unpredictably in a row, and a wrapped flex row puts a leading
     hairline at the start of the second line, which reads as a mistake. At
     64rem and up they fit on one line, so the separators can be real.
     ---------------------------------------------------------------------- */
  .hero__credentials {
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
    margin-top: var(--spacing-stack);
    padding-top: 1rem;
    border-top: var(--border-hairline) solid var(--color-rule);
    list-style: none;
  }

  .hero__credential {
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-slate);
  }

  @media (min-width: 64rem) {
    .hero__credentials {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: baseline;
      gap: 0;
    }

    .hero__credential + .hero__credential {
      margin-inline-start: 1rem;
      padding-inline-start: 1rem;
      border-inline-start: var(--border-hairline) solid var(--color-rule);
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: var(--spacing-stack);
  }

  /* --- technical areas ------------------------------------------------------ */
  .hero__areas {
    /* 48px rather than `--spacing-block` (64px): the credibility strip added a
       fourth horizontal rule to this stack, and at 64px the four bands read as
       four unrelated blocks instead of one lockup. Re-measured after the strip
       landed rather than inherited from the layout that predated it. */
    margin-top: 3rem;
    padding-top: var(--spacing-gutter);
    border-top: var(--border-hairline) solid var(--color-rule);
  }

  .hero__areas-list {
    display: grid;
    gap: 0.75rem 2rem;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .hero__area {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.125rem 0;
    border-radius: var(--radius-sm);
    color: var(--color-slate);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .hero__area:hover {
    color: var(--color-accent);
  }

  .hero__area-ordinal {
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-rule);
  }

  .hero__area:hover .hero__area-ordinal {
    color: var(--color-accent);
  }

  .hero__area-name {
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
</style>

<script>
  /**
   * NOTE ON WHERE THIS SHIPS. Astro inlines a `<script>` chunk only while it is
   * under Vite's `build.assetsInlineLimit` (4096 bytes). Whether this one lands
   * inline or as `<script type="module" src=…>` changes nothing that the
   * performance contract measures: a module script is deferred either way, so
   * blocking critical-path bytes stay at 0 KB and the hero's semantic content
   * never waits on it. Both forms are already covered by the built CSP —
   * `script-src 'self'` plus a hash per inline block.
   */
  import { createMagnetLines } from '../visuals/hero/magnet-lines';

  const field = document.querySelector<HTMLElement>('[data-hero-field]');
  const section = field?.closest<HTMLElement>('section') ?? null;

  if (field && section) {
    /**
     * The pointer target is the SECTION, not the field. The field is
     * `pointer-events: none` so it cannot swallow a click meant for a CTA
     * beneath it, which means it never receives a pointer event of its own —
     * and it is not `window` either, so moving the pointer anywhere else on
     * the page costs this hero nothing.
     */
    const lines = createMagnetLines(field, { pointerTarget: section });
    lines.start();

    /**
     * At most one expensive visual runs at a time (docs/MOTION_SYSTEM.md §4).
     * The controller already stops itself when the hero leaves the viewport,
     * so this is the belt to that braces — but it is also the site's one
     * cross-island contract and it is kept deliberately: any element carrying
     * `data-stops-hero-visual` stops this field while it is on screen. No
     * global store, no event bus, no import across islands.
     */
    const rival = document.querySelector('[data-stops-hero-visual]');

    if (rival && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) lines.stop();
            else lines.start();
          }
        },
        { threshold: 0 },
      );
      observer.observe(rival);
    }

    /**
     * Navigation here is cross-document (there is no `<ClientRouter />`), so
     * the page is torn down wholesale and this is belt-and-braces. It is worth
     * the two lines anyway: it makes "no listener and no pending frame survive
     * this hero" a property the controller can be tested for rather than one
     * the runtime happens to provide.
     */
    window.addEventListener('pagehide', () => lines.destroy(), { once: true });
  }
</script>
