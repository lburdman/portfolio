---
/**
 * `/about/` and `/es/about/`, from one file.
 *
 * The defect this page exists to close is AUDIT.md 2.2: **both** the previous
 * `/about` and `/es/about` rendered three `<h2>`-rooted components and no
 * `<h1>` at all, so the page's primary topic was absent from the accessibility
 * tree and from search snippets. There is now exactly one `<h1>`, and the tree
 * below it descends h1 → h2 → h3 with no skipped level.
 *
 * Brief §11 asks for less motion here than anywhere else, so this page ships
 * none of its own: no entrance animation, no scroll effect, no island. The
 * calm is the design. It is also a Gate-5 page — built correctly and plainly,
 * not elaborated.
 *
 * Every string, including the ordering of the three teaching roles, resolves
 * from `t.about`. Nothing is written here.
 */

import Container from '@/components/ui/Container.astro';
import { DEFAULT_LOCALE, LOCALES, useTranslations, type Locale, type UIStrings } from '@/i18n';
import PageLayout from '@/layouts/PageLayout.astro';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);

/**
 * Explicit order. `t.about.roles` is a `Record`, and relying on object key
 * order to decide what a reader sees first is a contract nobody declared.
 * The ids are keys, not copy — the type checker rejects one that does not exist.
 */
const ROLE_IDS: readonly (keyof UIStrings['about']['roles'])[] = ['qiskit', 'digitalSystems', 'quantumComms'];
const roles = ROLE_IDS.map((id) => t.about.roles[id]);

const HEADING_ID = 'about-heading';
const CURRENTLY_ID = 'about-currently';
const TEACHING_ID = 'about-teaching';
const CLIENT_WORK_ID = 'about-client-work';
---

<PageLayout
  locale={locale}
  title={t.seo.about.title}
  description={t.seo.about.description}
  ogImageAlt={t.seo.ogImageAlt}
>
  <article class="about" aria-labelledby={HEADING_ID}>
    <Container width="content">
      <header class="about__header">
        <h1 id={HEADING_ID}>{t.about.heading}</h1>
        <p class="about__bio">{t.about.bio}</p>
        <ul class="about__facts">
          {t.about.facts.map((fact) => <li class="about__fact">{fact}</li>)}
        </ul>
      </header>

      <section class="about__block" aria-labelledby={CURRENTLY_ID}>
        <h2 id={CURRENTLY_ID} class="about__block-heading">{t.about.currentlyHeading}</h2>
        <ul class="about__interests">
          {t.about.interests.map((interest) => <li class="about__interest">{interest}</li>)}
        </ul>
      </section>

      <section class="about__block" aria-labelledby={CLIENT_WORK_ID}>
        <h2 id={CLIENT_WORK_ID} class="about__block-heading">{t.about.clientWorkHeading}</h2>
        <ul class="about__clients">
          {
            t.about.clientWork.map((client) => (
              <li class="about__client">
                <h3 class="about__client-name">{client.name}</h3>
                <p class="about__client-description">{client.description}</p>
                <a class="about__client-link" href={client.href} rel="noopener noreferrer" target="_blank">
                  {client.site}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about__block" aria-labelledby={TEACHING_ID}>
        <h2 id={TEACHING_ID} class="about__block-heading">{t.about.teachingHeading}</h2>
        <ol class="about__roles">
          {
            roles.map((role) => (
              <li class="about__role">
                <h3 class="about__role-title">{role.role}</h3>
                <p class="about__role-meta">
                  <span class="about__role-org">{role.org}</span>
                  <span class="about__role-period">{role.period}</span>
                </p>
                <p class="about__role-description">{role.description}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </Container>
  </article>
</PageLayout>

<style>
  .about {
    padding-block: var(--spacing-section);
  }

  .about__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-gutter);
    max-width: var(--container-prose);
  }

  .about__bio {
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--color-slate);
    text-wrap: pretty;
  }

  /* Factual chips: profession, university, city. Mono, because on this site
     mono is the annotation layer rather than a second body face. */
  .about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
    list-style: none;
  }

  .about__fact {
    padding: 0.125rem 0.5rem;
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .about__block {
    margin-top: var(--spacing-block);
    padding-top: var(--spacing-stack);
    border-top: var(--border-hairline) solid var(--color-rule);
  }

  .about__block-heading {
    font-size: var(--text-display-4);
  }

  .about__interests {
    margin-top: var(--spacing-gutter);
    max-width: var(--container-prose);
    list-style: none;
  }

  .about__interest {
    padding-block: 0.5rem;
    line-height: var(--leading-body);
    color: var(--color-slate);
  }

  .about__interest + .about__interest {
    border-top: var(--border-hairline) solid var(--color-rule);
  }

  .about__roles {
    margin-top: var(--spacing-gutter);
    display: grid;
    gap: var(--spacing-stack);
    list-style: none;
  }

  .about__role {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: var(--container-prose);
  }

  .about__role-title {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-normal);
  }

  .about__role-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .about__role-org {
    color: var(--color-ink);
  }

  .about__role-description {
    line-height: var(--leading-body);
    color: var(--color-slate);
    text-wrap: pretty;
  }

  /* --- client work ---------------------------------------------------------
     Deliberately quieter than a project card. This work is real and shipped,
     and it is not the argument the projects grid is making — the type scale
     says so without the copy having to.
     ---------------------------------------------------------------------- */

  .about__clients {
    list-style: none;
    display: grid;
    gap: var(--spacing-stack);
    margin: 0;
    padding: 0;
  }

  .about__client-name {
    font-family: var(--font-display);
    font-stretch: var(--display-width-wide);
    font-size: var(--text-display-4);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .about__client-description {
    margin-top: 0.5rem;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-slate);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .about__client-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-stretch: normal;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-label);
  }
</style>
