---
/**
 * The homepage, for every locale.
 *
 * `/` and `/es/` are rendered from this one file. That is the whole point of
 * the `[...locale]` catch-all (docs/ARCHITECTURE.md §2): the audit measured the
 * previous physical `src/pages/es/` tree at 86% duplicated lines *with drift
 * already shipped*, and a single file per route makes that class of bug
 * structurally impossible rather than merely fixed (AUDIT.md 5.1).
 *
 * The locale arrives as a **prop**, never by parsing `Astro.url`. `getStaticPaths`
 * already knows which locale it is emitting, so re-deriving it from the URL
 * would be a second routing authority — exactly what AUDIT.md 5.2 found wrong
 * with declaring Astro's `i18n` block and consuming it nowhere. The locale list
 * comes from `LOCALES`, so a third locale is a content change, not a code change.
 *
 * Section order is brief §5 / §40: Hero → Layers → Technical Worlds → Selected
 * Projects → Contact. Each component owns its own `<section>`, figure number
 * and heading, so this file composes and does not decorate.
 *
 * `Contact` closes the page and is the only element on the site carrying
 * `CONTACT_SECTION_ID`. The nav, the mobile menu, the footer and the Hero's
 * "Get in touch" all link to that anchor, and for the whole of the previous
 * pass none of them resolved — the section was specified (brief §12), its
 * strings were written in both dictionaries, and it was never composed here.
 * That is the entire defect: one missing line in this file.
 * `tests/anchors.test.ts` now fails if any in-page anchor loses its target.
 *
 * `spine` is passed here and nowhere else: the layer spine describes the
 * homepage's ordered descent and has nothing to annotate on any other page
 * (docs/MOTION_SYSTEM.md §2).
 *
 * `FieldBand` wraps the first two sections and nothing more. It is the magnet
 * field's containing block: the field runs from the top of the Hero to the
 * bottom of the descent and stops at the Technical Worlds ink band, and CSS
 * gives an absolutely-positioned element no way to span two siblings without an
 * ancestor that holds both. It composes; it adds no spacing and no ground of
 * its own, and the sections inside keep the ones they already had.
 */

import Contact from '@/components/home/Contact.astro';
import Hero from '@/components/home/Hero.astro';
import LayersSequence from '@/components/home/LayersSequence.astro';
import SelectedProjects from '@/components/home/SelectedProjects.astro';
import TechnicalWorlds from '@/components/home/TechnicalWorlds.astro';
import FieldBand from '@/components/visuals/hero/FieldBand.astro';
import { SITE } from '@/config/site';
import { DEFAULT_LOCALE, LOCALES, useTranslations, type Locale } from '@/i18n';
import PageLayout from '@/layouts/PageLayout.astro';

/**
 * English is the unprefixed default, so its `locale` param is `undefined` and
 * the route collapses to `/`. Spanish carries the `es` segment.
 */
export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);
const base = SITE.basePath;
---

<PageLayout
  locale={locale}
  title={t.seo.home.title}
  description={t.seo.home.description}
  ogImageAlt={t.seo.ogImageAlt}
  spine
>
  <FieldBand>
    <Hero locale={locale} t={t} base={base} />
    <LayersSequence locale={locale} t={t} base={base} />
  </FieldBand>
  <TechnicalWorlds locale={locale} t={t} base={base} />
  <SelectedProjects locale={locale} t={t} base={base} />
  <Contact locale={locale} t={t} base={base} />
</PageLayout>
