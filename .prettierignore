# Generated output — Prettier must never rewrite or check these.
# Without this file `prettier --write .` reformats build artefacts, and after a
# coverage run `format:check` reports failures in ~46 generated files
# (AUDIT.md 5.5).
dist/
coverage/
.astro/
node_modules/

# Lockfile: owned by npm, reformatting it produces spurious diffs.
package-lock.json

# Local scratch files (never committed — see .gitignore).
*.tmp.*

# Local agent state, never committed. `.claude/settings.local.json` is ignored by
# the developer's global gitignore, so it never reaches CI — but Prettier scans
# the working tree, not the index, and the CLI rewrites this file as permissions
# change. Without this entry `npm run verify` fails locally on a file the repo
# does not own. `.claude/worktrees/` holds full checkouts of this same repo.
.claude/settings.local.json
.claude/worktrees/
